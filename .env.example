# 복사해서 .env.local로 쓴다 (.env.local은 Git에 올리지 않는다)

# 백엔드 주소. 비워 두면 같은 출처의 /api를 쓰고, 로컬에서는 Vite가 localhost:8080으로 넘긴다
# 운영(Vercel Production): https://api.{도메인}
VITE_API_BASE_URL=

# true면 MSW 목업으로 API와 SSE를 흉내 낸다. 백엔드 없이 화면을 볼 때, Vercel 프리뷰에서 쓴다
VITE_USE_MOCK=true

# LoaPulse 디스코드 서버 초대 링크. DM이 서버 이탈로 실패한 사용자에게 "서버 다시 참여" 버튼으로 보여준다
# 비워 두면 버튼 대신 설정 화면 안내를 보여준다
VITE_DISCORD_INVITE_URL=

# 서비스 상태 화면에 임베드할 Grafana 공개 대시보드 주소 (https://grafana.{도메인}/public-dashboards/...)
# 비워 두면 그래프 자리에 안내만 보여준다
VITE_GRAFANA_DASHBOARD_URL=
